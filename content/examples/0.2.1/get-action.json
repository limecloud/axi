{
  "spec_version": "0.2.1",
  "kind": "action",
  "name": "documents.get",
  "purpose": "读取指定文档及当前修订",
  "contract_revision": "1",
  "effect": "read",
  "required_context": [
    "scope_id",
    "document_id"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scope_id": {
        "type": "string",
        "minLength": 1
      },
      "document_id": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "scope_id",
      "document_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "../../schemas/0.2.1/axi.schema.json#/$defs/result"
  },
  "authorization": "从调用身份核对 scope_demo 读取权限；审批写入还需 reviewer 权限。此例身份由本地程序模拟。",
  "idempotency": {
    "mode": "not_applicable"
  },
  "bindings": [
    {
      "kind": "cli",
      "target": "python examples/review/provider.py get"
    }
  ]
}
